# Environment variables for local development
# Copy this to .env and fill in the values needed by your deployment.

# ===== Search Provider API Keys =====
# Bing Web Search API v7 (https://portal.azure.com -> Cognitive Services)
BING_SEARCH_API_KEY=your-bing-api-key
# Google Custom Search JSON API (https://console.cloud.google.com/apis/credentials)
GOOGLE_SEARCH_API_KEY=your-google-api-key
# Google Custom Search Engine ID (https://programmablesearchengine.google.com/)
GOOGLE_CSE_CX=your-cse-engine-id

# ===== Internal Services =====
# Gateway -> Engine (HTTP/JSON; gRPC planned, see docs/IMPROVEMENT_REPORT.md)
ENGINE_URL=http://127.0.0.1:3000
# Required for standalone/Docker. Generate at least 32 random bytes and inject
# the same value into Engine and Gateway; never expose it through VITE_* vars.
ENCOREHUB_ENGINE_AUTH_TOKEN=
# Engine bind address (use 0.0.0.0:3000 in containers)
ENGINE_BIND=127.0.0.1:3000
# Gateway listen address
LISTEN_ADDR=127.0.0.1:8080
# Compose publishes Gateway on loopback by default. Set 0.0.0.0 only for an
# explicit network deployment and require a separate ENCOREHUB_AUTH_TOKEN.
ENCOREHUB_GATEWAY_HOST=127.0.0.1
ENCOREHUB_AUTH_TOKEN=
# Per-client Gateway limiter. Client entries expire after TTL and the store
# evicts least-recently-used entries at the hard capacity.
ENCOREHUB_RATE_LIMIT_RPS=30
ENCOREHUB_RATE_LIMIT_BURST=60
ENCOREHUB_RATE_LIMIT_TTL_SECONDS=600
ENCOREHUB_RATE_LIMIT_MAX_CLIENTS=10000
# Comma-separated CIDRs/IPs allowed to supply X-Forwarded-For. Leave empty for
# Tauri/direct mode so client-controlled forwarding headers are ignored.
ENCOREHUB_TRUSTED_PROXIES=

# Port negotiation:
# - Client / Tauri mode: when ENGINE_BIND and LISTEN_ADDR are unset, the
#   desktop app auto-finds free ports starting from 10000 (engine first, then
#   gateway on the next free port). Set the env vars above to pin ports.
# - Headless / standalone mode: ports always come from ENGINE_BIND and
#   LISTEN_ADDR (or their loopback defaults 127.0.0.1:3000 /
#   127.0.0.1:8080).
# - React receives only the negotiated Gateway port via get_service_ports; in
#   dev (non-Tauri) mode it uses VITE_GATEWAY_URL.

# ===== Logging =====
RUST_LOG=info
GO_LOG_LEVEL=debug
PYTHON_LOG_LEVEL=DEBUG
