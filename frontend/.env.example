# Frontend dev config (Vite). Copy to .env.local and adjust.
# All values are inlined into the bundle at build time — DO NOT put secrets here.

VITE_GATEWAY_URL=http://127.0.0.1:8080

# Required when the gateway has ENCOREHUB_AUTH_TOKEN set.
# Leave empty for local dev with auth disabled.
VITE_AUTH_TOKEN=
