{
	"$schema": "https://raw.githubusercontent.com/nicedoc/schemas/refs/heads/master/tauri/tauri.conf.schema.json",
	"productName": "EncoreHub",
	"version": "0.1.4",
	"identifier": "com.0d000721.encorehub.desktop",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:1420",
		"beforeDevCommand": "pnpm dev",
		"beforeBuildCommand": "pnpm generate:licenses && pnpm build"
	},
	"app": {
		"windows": [
			{
				"title": "EncoreHub",
				"width": 1200,
				"height": 800,
				"minWidth": 680,
				"minHeight": 480,
				"resizable": true,
				"fullscreen": false,
				"generalAutofillEnabled": false,
				"decorations": true,
				"transparent": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"externalBin": ["binaries/encorehub-gateway"],
		"resources": {
			"../../skills/": "skills/",
			"binaries/engine-runtime.json": "lib/engine-runtime.json",
			"binaries/gateway-runtime.json": "lib/gateway-runtime.json"
		},
		"windows": {
			"wix": {
				"fragmentPaths": ["wix/cleanup-runtime-data.wxs"],
				"componentRefs": ["CleanupRuntimeDataMarker"]
			},
			"nsis": {
				"installerHooks": "nsis/installer-hooks.nsh"
			}
		},
		"macOS": {
			"minimumSystemVersion": "12.0"
		},
		"linux": {
			"deb": {
				"depends": []
			}
		}
	},
	"plugins": {
		"shell": {
			"open": true
		}
	}
}
